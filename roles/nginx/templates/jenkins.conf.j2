##
## Jenkins reverse proxy configuration for Nginx
## Deployed by Ansible - includes TLS, security headers, rate limiting
## Ref: https://www.jenkins.io/doc/book/system-administration/reverse-proxy-configuration-with-jenkins/reverse-proxy-configuration-nginx/
##      OWASP Docker Security, CIS Benchmark, ADR-001
##

# Rate limiting zones
limit_req_zone $binary_remote_addr zone=jenkins_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=jenkins_api:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=jenkins_conn:10m;

upstream jenkins {
    keepalive 32;
    # Use IPv4 localhost for Jenkins backend.
    # Do NOT add both 127.0.0.1 and [::1] — NGINX will load-balance between
    # them, causing Jenkins to see requests from different IPs.
    server 127.0.0.1:{{ jenkins_port | default('8080') }};
}

# Required for Jenkins websocket agents
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# HTTP → HTTPS redirect
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_tokens off;
    ignore_invalid_headers off;

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_tokens off;
    ignore_invalid_headers off;

    # Jenkins web root (needed for static file optimization)
    root /var/run/jenkins/war/;

    ##
    ## TLS configuration (strong, modern)
    ## Ref: https://ssl-config.mozilla.org/ - Intermediate profile
    ##
    ssl_certificate     /etc/nginx/ssl/jenkins.crt;
    ssl_certificate_key /etc/nginx/ssl/jenkins.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # OCSP stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 1.1.1.1 8.8.8.8 valid=300s;
    resolver_timeout 5s;

    ##
    ## Security headers
    ## Ref: OWASP Secure Headers Project, Mozilla Observatory
    ##
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header X-XSS-Protection          "0" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    # HSTS (1 year) - uncomment only after confirming TLS works correctly
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Content Security Policy
    # NOTE: Jenkins plugins often require 'unsafe-inline' and 'unsafe-eval' for scripts.
    # Adjust this policy based on your specific plugin set.
    add_header Content-Security-Policy "
        default-src 'self';
        script-src 'self' 'unsafe-inline' 'unsafe-eval';
        style-src 'self' 'unsafe-inline';
        img-src 'self' data:;
        font-src 'self' data:;
        connect-src 'self';
        form-action 'self';
        frame-ancestors 'self';
        base-uri 'self';
    " always;

    ##
    ## Proxy configuration to Jenkins backend
    ##
    location ~ "^\/static\/[0-9a-fA-F]{8}\/(.*)$" {
        # Rewrite static files with cache hashes to root
        # E.g. /static/12345678/css/something.css becomes /css/something.css
        rewrite "^\/static\/[0-9a-fA-F]{8}\/(.*)" /$1 last;
    }

    location /userContent {
        # Have nginx handle static requests to userContent folder ($JENKINS_HOME)
        root /var/lib/jenkins/;
        if (!-f $request_filename) {
            rewrite (.*) /$1 last;
            break;
        }
        sendfile on;
    }

    location / {
        sendfile off;
        proxy_pass          http://jenkins;
        proxy_redirect      default;
        proxy_http_version  1.1;

        # Required for Jenkins websocket agents
        proxy_set_header    Connection        $connection_upgrade;
        proxy_set_header    Upgrade           $http_upgrade;

        # Standard proxy headers
        proxy_set_header    Host              $http_host;
        proxy_set_header    X-Real-IP         $remote_addr;
        proxy_set_header    X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
        proxy_set_header    X-Forwarded-Host  $host;
        proxy_set_header    X-Forwarded-Port  $server_port;

        # Prevent proxy buffering to disk
        proxy_max_temp_file_size 0;

        # Proxy buffer settings
        proxy_buffering     on;
        proxy_buffer_size   4k;
        proxy_buffers       8 4k;
        proxy_busy_buffers_size 8k;

        # Timeouts
        proxy_connect_timeout   30s;
        proxy_send_timeout      60s;
        proxy_read_timeout      90s;

        # Disable request body buffering for Jenkins CLI
        proxy_request_buffering off;

        # Maximum upload size
        client_max_body_size       10m;
        client_body_buffer_size    128k;

        # Rate limiting for login page
        location ~* /j_acegi_security_check {
            limit_req  zone=jenkins_login burst=3 nodelay;
            limit_conn jenkins_conn 5;
            proxy_pass http://jenkins;
        }

        # Rate limiting for API
        location ~* /(api|crumbIssuer) {
            limit_req  zone=jenkins_api burst=10 nodelay;
            proxy_pass http://jenkins;
        }
    }

    # Deny access to VCS directories
    location ~* (\.git|\.svn|\.hg|/WEB-INF|/META-INF) {
        deny all;
        return 404;
    }

    # Deny access to hidden files (dotfiles)
    location ~ /\. {
        deny all;
        return 404;
    }

    # Logging
    access_log /var/log/nginx/jenkins-access.log;
    error_log  /var/log/nginx/jenkins-error.log warn;
}
